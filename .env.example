# ─── KuaDashboard — Environment Variables ────────────────────────────────────
# Copy this file to .env and fill in the values relevant to your setup.
# All variables are optional unless marked as REQUIRED.

# ─── Server ──────────────────────────────────────────────────────────────────

# Port the Express backend listens on (default: 7190)
PORT=7190

# Bind locally. KUA_HOSTNAME only allows an additional HTTP Host; it does not
# change the listener, DNS resolution, URLs or OAuth callbacks.
# KUA_HOST=127.0.0.1
# KUA_HOSTNAME=kua.localhost

# ─── Credential Vault ────────────────────────────────────────────────────────

# Passphrase used to encrypt the local vault file (~/.kube/kuadashboard_envs.enc).
# If not set, a machine-derived fallback (hostname + username) is used.
# Recommended: set a strong value in production/shared deployments.
KUADASHBOARD_VAULT_PASS=kuadashboard_secret_passphrase

# Force a specific credential store backend.
# Options: "keytar" (OS native keychain) | unset (auto: keytar in Electron, file elsewhere)
# KUADASHBOARD_STORE=keytar

# ─── Vercel OAuth (optional user-owned integration) ──────────────────────────
# Official builds use the hosted exchange; no OAuth client secret is bundled.
# For your own integration, set BOTH variables in your local environment only.
# The HTTPS callback forwards to kua://vercel/callback.
# VERCEL_OAUTH_CLIENT_ID=your_integration_id
# VERCEL_OAUTH_CLIENT_SECRET=your_own_secret
# VERCEL_OAUTH_REDIRECT_URI=https://lnavarrocarter.github.io/kuadashboard/vercel-callback
