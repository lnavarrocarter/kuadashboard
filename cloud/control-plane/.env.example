NODE_ENV=development
PORT=8080

# Public URLs
CONTROL_PLANE_URL=http://localhost:8080
FRONTEND_URL=https://kuadashboard.navarrocarter.com

# Google OAuth / OpenID Connect
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/auth/google/callback

# Session signing secret. Use Secret Manager in Cloud Run.
KUA_SESSION_SECRET=

# Stripe Billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=

# Optional local Firestore emulator. Production uses the Cloud Run service identity.
GOOGLE_CLOUD_PROJECT=ncaicloud
GCP_DATABASE_MODE=datastore
# Use `firestore` only with a Firestore Native database.
FIRESTORE_EMULATOR_HOST=
