# Copy to .env.local (gitignored) to enable the Account/Console features that
# talk to the KUA Control Plane (cloud login, entitlements, billing). Leave
# empty/unset to hide those features entirely — every local/free feature works
# with no control plane configured.
#
# Local control plane: http://localhost:8080 (see ../cloud/control-plane/README.md)
VITE_CONTROL_PLANE_URL=
